let bad = 0;
for (const c of cases) {
  const r = postingBody(c.raw); const problems: string[] = [];
  if ((c.state ?? "ok") !== r.state) problems.push(`state ${r.state}`);
  if (!c.starts.test(r.text)) problems.push(`starts: ${JSON.stringify(r.text.slice(0, 70))}`);
  for (const k of c.keeps) if (!r.text.includes(k)) problems.push(`lost: ${k}`);
  for (const d of c.drops) if (r.text.includes(d)) problems.push(`still there: ${d}`);
  if (c.rule ? !r.rules.includes(c.rule) : r.rules.length > 0) problems.push(`rules: ${r.rules.join(",") || "none"}`);
  if (problems.length) bad++;
  console.log(`${problems.length ? "WRONG" : "ok   "} ${c.name}  [${c.raw.length} → ${r.text.length} chars; ${r.rules.join(", ") || "unchanged"}]${problems.length ? "\n        " + problems.join("\n        ") : ""}`);
}
// the same input always gives the same output, and nothing throws on odd input
for (const odd of [null, undefined, "", "   ", "{", '{"sections":', "Skip to main content", "x".repeat(50000)]) { const a = postingBody(odd as any), b = postingBody(odd as any); if (a.text !== b.text) { bad++; console.log("WRONG not deterministic"); } }
if (bad) { console.error(`${bad} wrong`); process.exit(1); }
console.log("all right");
