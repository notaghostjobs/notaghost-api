    raw: "About the role: you will own our consent platform. " + "Responsibilities include privacy engineering and partner integrations. ".repeat(90) + "You will build the Cookie Consent Manager our customers use, and the Apply now » button flow for partner sites. Requirements: 6+ years in privacy engineering.",
    starts: /^About the role: you will own our consent platform/, keeps: ["Requirements: 6+ years in privacy engineering."], drops: [] },
